# ─────────────────────────────────────────────────────────────────────────────
# 03-config-recorders — copy to terraform.tfvars and edit.
#
# This layer reads BOTH 01-organization (account IDs) and 02-logging (the
# Config bucket), so 02-logging must be applied first.
# ─────────────────────────────────────────────────────────────────────────────

terraform-profile = "my-management-profile"

state_bucket        = "acme-lz-terraform-state-a1b2"
state_bucket_region = "us-east-1"
