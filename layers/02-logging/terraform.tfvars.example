# ─────────────────────────────────────────────────────────────────────────────
# 02-logging — copy to terraform.tfvars and edit.
# ─────────────────────────────────────────────────────────────────────────────

terraform-profile = "my-management-profile"

# Where this layer reads 01-organization's outputs from.
# Both values come from: cd ../00-bootstrap && terraform output
state_bucket        = "acme-lz-terraform-state-a1b2"
state_bucket_region = "us-east-1"

# These buckets live in the LogArchive account and hold org-wide audit data.
# Globally unique names required — reuse the same unique suffix as bootstrap.
cloudtrail_bucket_name = "acme-lz-cloudtrail-logs-a1b2"
config_bucket_name     = "acme-lz-config-logs-a1b2"
flow_logs_bucket_name  = "acme-lz-flow-logs-a1b2"
