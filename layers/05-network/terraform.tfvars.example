# ─────────────────────────────────────────────────────────────────────────────
# 05-network — copy to terraform.tfvars and edit.
#
# NOTE: VPC CIDRs are NOT variables. They are written inline in
# network-vpc.tf, workload-vpcs.tf and sandbox-vpc.tf so you can see the whole
# address plan in one place instead of chasing it through a variables file.
# See README.md in this directory for the plan and how to change it.
# ─────────────────────────────────────────────────────────────────────────────

terraform-profile = "my-management-profile"

state_bucket        = "acme-lz-terraform-state-a1b2"
state_bucket_region = "us-east-1"
