# ─────────────────────────────────────────────────────────────────────────────
# 04-security — copy to terraform.tfvars and edit.
# ─────────────────────────────────────────────────────────────────────────────

aws_region        = "us-east-1"
terraform-profile = "my-management-profile"

state_bucket        = "acme-lz-terraform-state-a1b2"
state_bucket_region = "us-east-1"

# Must match 01-organization. Security tooling is deployed into both regions.
allowed_regions = {
  primary   = "us-east-1"
  secondary = "ap-south-1"
}

# SNS subscription for GuardDuty / Security Hub findings. AWS sends a
# confirmation email to this address — the subscription stays "pending"
# until someone clicks the link. A distribution list beats an individual.
alert_email = "security-alerts@example.com"
