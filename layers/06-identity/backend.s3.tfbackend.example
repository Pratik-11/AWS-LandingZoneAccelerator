# ─────────────────────────────────────────────────────────────────────────────
# EXAMPLE: S3 Remote Backend Configuration — 06-identity layer
# ─────────────────────────────────────────────────────────────────────────────
#
# STEP 1: Copy this file to backend.s3.tfbackend
#         cp backend.s3.tfbackend.example backend.s3.tfbackend
#
# STEP 2: Fill in the values below. You can find them by running:
#         cd layers/00-bootstrap && terraform output
#
# STEP 3: Initialize Terraform with the backend config:
#         terraform init -backend-config=backend.s3.tfbackend
#
# ─────────────────────────────────────────────────────────────────────────────
#
# bucket         — The S3 bucket created by 00-bootstrap (state_bucket_name output)
#                  Example: "acme-lz-terraform-state-a1b2"
#
# key            — Unique path inside the bucket for THIS layer's state file.
#                  Do NOT change this — it is pre-set for 06-identity.
#
# region         — The AWS region where your S3 bucket was created.
#                  Must match var.aws_region in 00-bootstrap (default: us-east-1).
#
# dynamodb_table — The DynamoDB table created by 00-bootstrap (dynamodb_table_name output)
#                  Example: "acme-lz-terraform-locks-a1b2"
#
# encrypt        — Always true. Enforces server-side encryption on the state file.
#
# ─────────────────────────────────────────────────────────────────────────────

bucket         = "<org_name>-lz-terraform-state-<unique_id>"
key            = "lz/06-identity/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "<org_name>-lz-terraform-locks-<unique_id>"
encrypt        = true
