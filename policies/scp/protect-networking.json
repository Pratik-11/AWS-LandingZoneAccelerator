{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProtectNetworking",
      "Effect": "Deny",
      "Action": [
        "ec2:DeleteTransitGateway",
        "ec2:DeleteVpc",
        "ec2:DeleteVpnConnection",
        "ec2:DeleteCustomerGateway"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::*:role/OrganizationAccountAccessRole"
        }
      }
    }
  ]
}
